#include "iSH.xcconfig"

MARKETING_VERSION = 1.3.3

ENABLE_BITCODE = NO // no idea why
PRODUCT_BUNDLE_IDENTIFIER = $(ROOT_BUNDLE_IDENTIFIER)
PRODUCT_APP_GROUP_IDENTIFIER = group.$(ROOT_BUNDLE_IDENTIFIER)
IPHONEOS_DEPLOYMENT_TARGET = 11.0
VERSIONING_SYSTEM = apple-generic

MESON_BUILD_DIR = $(CONFIGURATION_BUILD_DIR)/meson
NINJA_TARGETS = libish.a libish_emu.a libfakefs.a

SUPPORTED_PLATFORMS = iphonesimulator iphoneos macosx

// NodeMobile (Claude Code native runtime)
HEADER_SEARCH_PATHS = $(inherited) $(PROJECT_DIR)/deps/NodeMobile/NodeMobile.xcframework/ios-arm64_x86_64-simulator/NodeMobile.framework/Headers
FRAMEWORK_SEARCH_PATHS = $(inherited) $(PROJECT_DIR)/deps/NodeMobile/NodeMobile.xcframework/ios-arm64_x86_64-simulator
OTHER_LDFLAGS = $(inherited) -framework NodeMobile
